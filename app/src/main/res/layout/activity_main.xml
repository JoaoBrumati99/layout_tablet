<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagem de Fundo (Workspace / Escritório) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/office_bg"
        android:contentDescription="@null"/>

    <!-- Camada de escurecimento sutil para dar contraste -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000"/>

    <!-- Container Branco Principal (Dashboard) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="0dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="0dp">

        <!-- LADO ESQUERDO: Sidebar (Logo, Clima, Horário, Data) -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="#FAFCFF">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_amalfis_color"
                android:contentDescription="@string/app_name"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"/>

            <!-- Clima / Temperatura -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_brightness"
                        app:tint="#F59E0B"
                        android:contentDescription="@string/weather_condition"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/temp_value"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/amalfis_primary_dark"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weather_condition"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/amalfis_primary"
                    android:layout_marginStart="50dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/location_weather"
                    android:textSize="12sp"
                    android:textColor="@color/text_caption"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="28dp"/>

            <!-- Horário-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_restart"
                        app:tint="@color/amalfis_primary"
                        android:contentDescription="@string/time_label"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/time_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_caption"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:24"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/amalfis_primary_dark"
                    android:layout_marginStart="44dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="28dp"/>

            <!-- Data do dia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/amalfis_primary"
                        android:contentDescription="@string/date_label"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/date_label"
                        android:textSize="14sp"
                        android:textColor="@color/text_caption"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25/09/2025"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/amalfis_primary_dark"
                    android:layout_marginStart="44dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Divisor vertical entre sidebar e conteúdo -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider"/>

        <!-- LADO DIREITO: Conteúdo principal (Header com "Tablet - reunião", boas-vindas e cards) -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="36dp">

            <!-- Topo Direito: Tablet - reunião com ponto verde -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_web"
                    app:tint="@color/amalfis_primary"
                    android:contentDescription="@string/device_name"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/device_name"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/amalfis_primary_dark"/>

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/green_dot"/>
            </LinearLayout>

            <!-- Título de Boas-vindas -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentTop="true"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_title"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/amalfis_primary_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/welcome_subtitle"
                    android:textSize="16sp"
                    android:textColor="@color/text_caption"/>
            </LinearLayout>

            <!-- Grid de Cards (2x3) com Scroll -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/headerLayout"
                android:fillViewport="true"
                android:scrollbars="none"
                android:clipToPadding="false">

                <GridLayout
                    android:id="@+id/cardsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:alignmentMode="alignBounds"
                    android:useDefaultMargins="false">

                <!-- Card 1: Câmera -->
                <LinearLayout
                    android:id="@+id/cardCamera"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_margin="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_background"
                    android:elevation="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_circle_camera">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/white"
                            android:contentDescription="@string/camera"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/camera"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/camera_caption"
                            android:textSize="13sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="@color/text_caption"
                        android:contentDescription="@null"/>
                </LinearLayout>

                <!-- Card 2: Galeria -->
                <LinearLayout
                    android:id="@+id/cardGallery"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_margin="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_background"
                    android:elevation="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_circle_gallery">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_gallery"
                            app:tint="@color/white"
                            android:contentDescription="@string/gallery"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gallery"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/gallery_caption"
                            android:textSize="13sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="@color/text_caption"
                        android:contentDescription="@null"/>
                </LinearLayout>

                <!-- Card 3: Taylo -->
                <LinearLayout
                    android:id="@+id/cardSite"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_margin="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_background"
                    android:elevation="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_circle_site">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_web"
                            app:tint="@color/white"
                            android:contentDescription="@string/site"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/site"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/site_caption"
                            android:textSize="13sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="@color/text_caption"
                        android:contentDescription="@null"/>
                </LinearLayout>

                <!-- Card 4: Tkron -->
                <LinearLayout
                    android:id="@+id/cardTkron"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_margin="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_background"
                    android:elevation="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_circle_tkron">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_web"
                            app:tint="@color/white"
                            android:contentDescription="@string/tkron_site"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tkron_site"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tkron_caption"
                            android:textSize="13sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="@color/text_caption"
                        android:contentDescription="@null"/>
                </LinearLayout>

                <!-- Card 5: Configuração -->
                <LinearLayout
                    android:id="@+id/cardSettings"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_row="2"
                    android:layout_column="0"
                    android:layout_columnSpan="2"
                    android:layout_margin="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_background"
                    android:elevation="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_circle_settings">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_admin"
                            app:tint="@color/white"
                            android:contentDescription="@string/settings_card"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_card"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_card_caption"
                            android:textSize="13sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="@color/text_caption"
                        android:contentDescription="@null"/>
                </LinearLayout>

            </GridLayout>

        </ScrollView>

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
