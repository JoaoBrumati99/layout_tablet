<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Cabeçalho -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/amalfis_primary"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:background="@drawable/back_button_bg"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="12dp"
            android:text="@string/settings_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_dark"/>

        <!-- Topo Direito: Dispositivo online + Ponto Verde -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/green_dot"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_online"
                android:textSize="14sp"
                android:textColor="@color/text_on_dark"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- Conteúdo Scrollable em Coluna Única de Largura Total -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerBar"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. SEÇÃO: STATUS DO DISPOSITIVO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_device_status"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/section_label"
                android:layout_marginBottom="8dp"/>

            <!-- Linha de 3 Cards de Status de Mesmo Tamanho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- Card 1: Bateria -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card_background"
                    android:elevation="0dp"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/icon_circle_battery">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_battery"
                                app:tint="@color/white"
                                android:contentDescription="@string/battery_label"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/battery_label"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/amalfis_primary_dark"/>

                            <TextView
                                android:id="@+id/txtBattery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/amalfis_primary"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtBatteryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carregando"
                        android:textSize="11sp"
                        android:textColor="@color/text_caption"
                        android:layout_marginTop="8dp"
                        android:layout_gravity="center_horizontal"/>
                </LinearLayout>

                <!-- Card 2: Brilho da tela (Mesmo peso/tamanho weight=1) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card_background"
                    android:elevation="0dp"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/icon_circle_brightness">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_brightness"
                                app:tint="@color/white"
                                android:contentDescription="@string/brightness_label"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/brightness_label"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/amalfis_primary_dark"/>

                            <TextView
                                android:id="@+id/txtBrightness"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/amalfis_primary"/>
                        </LinearLayout>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:progressTint="@color/amalfis_primary"
                        android:thumbTint="@color/amalfis_primary"
                        android:max="255"/>
                </LinearLayout>

                <!-- Card 3: Rotação de tela (Mesmo peso/tamanho weight=1) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card_background"
                    android:elevation="0dp"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/icon_circle_rotation">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_rotate"
                                app:tint="@color/white"
                                android:contentDescription="@string/rotation_label"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/rotation_label"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/amalfis_primary_dark"/>

                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchRotation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/amalfis_primary"
                            android:trackTint="@color/divider"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtRotationCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rotation_caption_off"
                        android:textSize="11sp"
                        android:textColor="@color/text_caption"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- 2. SEÇÃO: CONECTIVIDADE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_connectivity"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/section_label"
                android:layout_marginBottom="8dp"/>

            <!-- Linha de 2 Cards de Conectividade de Mesmo Tamanho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- Card Wi-Fi -->
                <LinearLayout
                    android:id="@+id/btnWifi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/settings_card_background"
                    android:elevation="0dp"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/icon_circle_wifi">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_wifi"
                            app:tint="@color/white"
                            android:contentDescription="@string/wifi_label"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wifi_label"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wifi_caption"
                            android:textSize="12sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="@color/text_caption"
                        android:contentDescription="@null"/>
                </LinearLayout>

                <!-- Card Modo avião -->
                <LinearLayout
                    android:id="@+id/btnAirplane"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/settings_card_background"
                    android:elevation="0dp"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/icon_circle_airplane">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_airplane"
                            app:tint="@color/white"
                            android:contentDescription="@string/airplane_label"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/airplane_label"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/airplane_caption"
                            android:textSize="12sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="@color/text_caption"
                        android:contentDescription="@null"/>
                </LinearLayout>

            </LinearLayout>

            <!-- 3. SEÇÃO: ENERGIA (Abaixo de Conectividade, Largura Total) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_power"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/section_label"
                android:layout_marginBottom="8dp"/>

            <!-- Card Ligar/Desligar Agendado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_card_background"
                android:elevation="0dp"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <!-- Header Ligar/Desligar Agendado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/icon_circle_restart">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_restart"
                            app:tint="@color/white"
                            android:contentDescription="@string/schedule_label"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_label"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_caption"
                            android:textSize="11sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/amalfis_primary"
                        android:trackTint="@color/divider"/>
                </LinearLayout>

                <!-- Dias da semana label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_days"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/section_label"
                    android:layout_marginBottom="8dp"/>

                <!-- Chips dos Dias da Semana -->
                <LinearLayout
                    android:id="@+id/layoutScheduleDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/chipSeg"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:gravity="center"
                        android:text="SEG"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/chip_active"/>

                    <TextView
                        android:id="@+id/chipTer"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:gravity="center"
                        android:text="TER"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/chip_active"/>

                    <TextView
                        android:id="@+id/chipQua"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:gravity="center"
                        android:text="QUA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/chip_active"/>

                    <TextView
                        android:id="@+id/chipQui"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:gravity="center"
                        android:text="QUI"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/chip_active"/>

                    <TextView
                        android:id="@+id/chipSex"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:gravity="center"
                        android:text="SEX"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/chip_active"/>

                    <TextView
                        android:id="@+id/chipSab"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:gravity="center"
                        android:text="SÁB"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#5B6B7C"
                        android:background="@drawable/chip_inactive"/>

                    <TextView
                        android:id="@+id/chipDom"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:gravity="center"
                        android:text="DOM"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#5B6B7C"
                        android:background="@drawable/chip_inactive"/>
                </LinearLayout>

                <!-- Caixas Seleção de Horário -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Box Horário Ligar -->
                    <LinearLayout
                        android:id="@+id/layoutPowerOn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical"
                        android:background="@drawable/time_box_bg"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_power_on"
                            android:textSize="12sp"
                            android:textColor="@color/text_caption"
                            android:layout_gravity="center_horizontal"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_restart"
                                app:tint="@color/amalfis_primary"
                                android:contentDescription="@null"/>

                            <TextView
                                android:id="@+id/txtPowerOn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="07:00"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/amalfis_primary_dark"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"/>

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_back"
                                android:rotation="270"
                                app:tint="@color/text_caption"
                                android:contentDescription="@null"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Box Horário Desligar -->
                    <LinearLayout
                        android:id="@+id/layoutPowerOff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical"
                        android:background="@drawable/time_box_bg"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_power_off"
                            android:textSize="12sp"
                            android:textColor="@color/text_caption"
                            android:layout_gravity="center_horizontal"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_restart"
                                app:tint="@color/amalfis_primary"
                                android:contentDescription="@null"/>

                            <TextView
                                android:id="@+id/txtPowerOff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18:00"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/amalfis_primary_dark"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"/>

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_back"
                                android:rotation="270"
                                app:tint="@color/text_caption"
                                android:contentDescription="@null"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- 4. SEÇÃO: ATALHOS DA TELA PRINCIPAL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_shortcuts"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/section_label"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_card_background"
                android:elevation="0dp"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <!-- Ocultar Câmera -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_camera"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_camera_caption"
                            android:textSize="11sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchHideCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/amalfis_primary"
                        android:trackTint="@color/divider"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Ocultar Galeria -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_gallery"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_gallery_caption"
                            android:textSize="11sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchHideGallery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/amalfis_primary"
                        android:trackTint="@color/divider"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Ocultar Taylo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_taylo"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_taylo_caption"
                            android:textSize="11sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchHideTaylo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/amalfis_primary"
                        android:trackTint="@color/divider"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Ocultar Tkron -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_tkron"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/amalfis_primary_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hide_tkron_caption"
                            android:textSize="11sp"
                            android:textColor="@color/text_caption"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchHideTkron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/amalfis_primary"
                        android:trackTint="@color/divider"/>
                </LinearLayout>

            </LinearLayout>

            <!-- 5. SEÇÃO: ÁREA RESTRITA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_admin"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/section_label"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/btnExitApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/exit_button_background"
                android:elevation="0dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#33FFFFFF">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_exit"
                        app:tint="@color/white"
                        android:contentDescription="@string/exit_app"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exit_app"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exit_app_caption"
                        android:textSize="11sp"
                        android:textColor="#E6FFFFFF"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/white"
                    android:contentDescription="@string/exit_app_caption"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
